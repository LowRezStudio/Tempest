{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"sourceMap": true,
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"],
			"$ipc": ["./electron/src/ipc"],
			"$ipc/*": ["./electron/src/ipc/*"]
		}
	},
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker"]
}
