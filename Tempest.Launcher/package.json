{
	"name": "tempest.launcher",
	"version": "1.5.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:cli": "dotnet build ../Tempest.slnx",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:electron": "pnpm -C electron typecheck",
		"proto-generate": "node scripts/generate-proto.js",
		"fmt": "oxfmt --write .",
		"lint": "svelte-kit sync && oxlint --type-aware",
		"bump": "node scripts/bump.js",
		"electron:dev": "pnpm -C electron dev",
		"electron:build": "pnpm -C electron build"
	},
	"devDependencies": {
		"@fontsource-variable/ubuntu-sans-mono": "^5.3.0",
		"@inlang/paraglide-js": "^2.29.1",
		"@lucide/svelte": "^1.61.0",
		"@protobuf-ts/grpcweb-transport": "^2.11.1",
		"@protobuf-ts/plugin": "^2.11.1",
		"@protobuf-ts/protoc": "^2.11.1",
		"@protobuf-ts/runtime": "^2.11.1",
		"@protobuf-ts/runtime-rpc": "^2.11.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/svelte-query": "^6.3.5",
		"bits-ui": "^2.20.0",
		"country-flag-emoji-polyfill": "^0.1.10",
		"daisyui": "^5.7.50",
		"dax": "^0.50.1",
		"feedsmith": "^3.0.1",
		"marked": "^18.1.1",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "catalog:"
	}
}
