{
	"name": "tempest.launcher",
	"version": "1.4.4",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:cli": "dotnet build ../Tempest.slnx",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "cd .. && husky Tempest.Launcher/.husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:electron": "pnpm -C electron typecheck",
		"proto-generate": "node scripts/generate-proto.js",
		"fmt": "oxfmt --write .",
		"lint": "oxlint --type-aware",
		"bump": "node scripts/bump.js",
		"electron:dev": "pnpm -C electron dev",
		"electron:build": "pnpm -C electron build"
	},
	"devDependencies": {
		"@fontsource-variable/ubuntu-sans-mono": "^5.3.0",
		"@inlang/paraglide-js": "^2.29.1",
		"@lucide/svelte": "^1.61.0",
		"@protobuf-ts/grpcweb-transport": "^2.11.1",
		"@protobuf-ts/plugin": "^2.11.1",
		"@protobuf-ts/protoc": "^2.11.1",
		"@protobuf-ts/runtime": "^2.11.1",
		"@protobuf-ts/runtime-rpc": "^2.11.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/svelte-query": "^6.3.5",
		"bits-ui": "^2.20.0",
		"country-flag-emoji-polyfill": "^0.1.10",
		"daisyui": "^5.7.50",
		"dax": "^0.50.1",
		"feedsmith": "^3.0.1",
		"husky": "^9.1.7",
		"marked": "^18.1.1",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2004",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
